---
import Base from '../../layouts/Base.astro';
import ShowcaseProject from '../../components/ShowcaseProject.astro';
import { entry, core } from '../../data/site.js';
import '../../styles/case.css';
const e = entry('projects', 'pwb-insole');
const build = [
  { src: '/images/pwb-unit.webp', w: 593, h: 696, alt: 'Red 3D-printed PLA housing open, showing the ESP32 processing unit, wiring and battery', cap: 'Processing unit: ESP32, LiPo and charging in a PLA housing' },
  { src: '/images/pwb-calibration.webp', w: 372, h: 476, alt: 'Foot on a bathroom scale with the phone app reading load during calibration', cap: 'Calibrating against a bathroom scale' },
  { src: '/images/pwb-app.webp', w: 371, h: 815, alt: 'Phone app showing a live load gauge and a load-over-time chart', cap: 'Live gauge in the Arduino Cloud app' },
  { src: '/images/pwb-accuracy.webp', w: 1100, h: 680, alt: 'Scatter plot of sensor reading against scale reading at 50% partial weight bearing, with a linear trend line', cap: 'Sensor vs scale at 50% body weight' },
];
const cad = [
  ['/images/pwb-cad-sock.webp', 1100, 922, 'CAD render of the double-layer sock with the processing unit at the ankle', 'Double-layer sock'],
  ['/images/pwb-cad-wiring.webp', 1100, 873, 'CAD render of the sock with internal wiring exposed', 'Internal wiring'],
  ['/images/pwb-cad-sensors.webp', 1100, 793, 'CAD render of the sock sole showing sensor placement', 'Sensor placement'],
  ['/images/pwb-cad-unit.webp', 1100, 753, 'CAD renders of the miniaturized processing unit from several angles', 'Miniaturized processing unit'],
];
---
<Base title={e.page.title} crumb={e.page.crumb} section="Projects" description={e.page.description}>
<div class="wrap"><a class="back" href="/#projects">Back to all projects</a></div>

<ShowcaseProject c={core(e, 'insole')} role={e.page.roleLine}>
  <div slot="demo" class="wrap demo">
    <div class="gal gal4">
      {build.map(g => (
        <figure><a href={g.src} target="_blank" rel="noopener"><img src={g.src} alt={g.alt} width={g.w} height={g.h} loading="lazy" /></a><figcaption>{g.cap}</figcaption></figure>
      ))}
    </div>
  </div>
</ShowcaseProject>

<div class="wrap">
<section class="xtra" id="cad">
  <h2>Modeling</h2>
  <p class="xtra-lead">The CAD for the next version: wiring sealed inside a double-layer sock and a processing unit small enough to sit at the ankle.</p>
  <div class="gal">
    {cad.map(([src, w, h, alt, cap]) => (
      <figure><a href={src} target="_blank" rel="noopener"><img src={src} alt={alt} width={w} height={h} loading="lazy" /></a><figcaption>{cap}</figcaption></figure>
    ))}
  </div>
</section>
</div>

</Base>

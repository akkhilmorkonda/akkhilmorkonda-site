---
import Base from '../../layouts/Base.astro';
import ShowcaseHero from '../../components/ShowcaseHero.astro';
import ShowcaseProject from '../../components/ShowcaseProject.astro';
import { entry, core } from '../../data/site.js';
import '../../styles/case.css';
const e = entry('projects', 'mediscan');
const gallery = [
  { src: '/images/mediscan-housing.webp', w: 491, h: 300, alt: 'Printed white MediScan housing with a sensor window and screw holes', cap: 'Printed NAAT and fluorescence housing' },
  { src: '/images/mediscan-housing-drawing.webp', w: 1164, h: 823, alt: 'Engineering drawing of the updated MediScan housing, 119 by 86.56 mm', cap: 'Housing drawing, 119 x 86.56 mm' },
  { src: '/images/mediscan-fluor-schematic.webp', w: 1154, h: 800, alt: 'Schematic of the fluorescence sensing board: four AS7341 spectral sensors, a color sensor, a TCA9548A I2C multiplexer and two 470 nm LEDs', cap: 'Fluorescence sensing PCB, schematic' },
  { src: '/images/mediscan-fluor-pcb.webp', w: 556, h: 797, alt: 'Two-layer layout of the fluorescence sensing PCB', cap: 'Fluorescence sensing PCB, layout' },
];
---
<Base title={e.page.title} crumb={e.page.crumb} section="Projects" description={e.page.description}>
<div class="wrap"><a class="back" href="/#projects">Back to all projects</a></div>

<div class="wrap"><ShowcaseHero e={e} /></div>

<ShowcaseProject c={core(e, 'heating')}>
  <Fragment slot="demo">
<section class="explode" id="msExplode"><div class="stick"><canvas id="msRig" role="img" aria-label="Exploded 3D model of the MediScan NAAT module: control and power board, sensing board, microfluidic chip and heating plate"></canvas>
  <div class="steps"><h2>Inside the NAAT module</h2>
    <div class="st"><b>The stack</b><p>A control board, a sensing board, the microfluidic chip and a heating plate. NAAT amplifies genetic material at a constant 65°C, so it needs no PCR hardware.</p></div>
    <div class="st"><b>Control and power</b><p>An ESP32 runs the heater loop and the optics. USB-C and a solar cell charge a 5000 mAh LiPo; a 2.4" display and buttons run the test.</p></div>
    <div class="st"><b>Heater drive</b><p>A boost converter lifts the 3.3V rail to 5V for the heater, switched low-side by a MOSFET under PWM. A soldered thermal fuse cuts power on runaway.</p></div>
    <div class="st"><b>Four optical channels</b><p>Underneath, each channel pairs a blue LED with a Vishay TEMD6200 photodiode, both facing the chip. Detection works in reflection.</p></div>
    <div class="st"><b>Microfluidic chip</b><p>The sample sits in a clear PMMA chip, backed by a black PMMA layer, directly under the optical channels.</p></div>
    <div class="st"><b>Heating plate</b><p>In direct contact with the chip through thermal grease. A thermistor at the heater feeds a PID loop on the ESP32 that holds 65°C within ±0.5°C.</p></div>
  </div><div class="prog" id="prog"></div><p class="loading note" aria-live="polite">Loading CAD model</p></div></section>
<div class="wrap"><p class="note ms-cap">Board models from the team's Altium CAD. Chip, heating plate and the stacked layout are simplified.</p></div>
  </Fragment>
</ShowcaseProject>

<ShowcaseProject c={core(e, 'optics')}>
  <div slot="demo" class="wrap demo"><section id="msSense">
  <div class="viewer ms-viewer">
    <div class="ms-plots">
      <div class="ms-x"><canvas id="msX" role="img" aria-label="Cross-section of one channel: blue LED and photodiode above a well in the chip, heating plate below"></canvas></div>
      <div class="ms-c"><canvas id="msC" role="img" aria-label="Photodiode signal over a 20 minute run for the Zika, dengue, malaria and RNase P control channels, with a detection threshold"></canvas><div class="tip" id="msTip"></div></div>
    </div>
    <div class="ctl">
      <div><label>Sample contains</label><div class="seg ms-seg4" id="msTarget"><button class="on" data-v="none">None</button><button data-v="zika">Zika</button><button data-v="dengue">Dengue</button><button data-v="malaria">Malaria</button></div></div>
      <div><label>Heater</label><div class="seg" id="msHeat"><button class="on" data-v="on">65°C</button><button data-v="off">Off</button></div></div>
      <div><label>Channels</label><div class="ms-ch">
        <button type="button"><span>Zika</span><em></em></button><button type="button"><span>Dengue</span><em></em></button><button type="button"><span>Malaria</span><em></em></button><button type="button"><span>RNase P control</span><em></em></button>
      </div></div>
      <div><label for="msT">Time <span class="val" id="msTv">0.0 min</span></label><input type="range" id="msT" min="0" max="200" value="0"></div>
      <div class="ms-v" id="msV" role="status" aria-live="polite">Reading</div>
      <button class="btn2" id="msRun">Run the test again</button>
      <p class="note">Illustrative model. Curve shapes, times and which channel reads which target are not measured data.</p>
    </div>
  </div>
  </section></div>
</ShowcaseProject>

<ShowcaseProject c={core(e, 'pcbs')} />

<div class="wrap">
<section class="xtra ms-gal" id="gallery">
  <h2>From the build</h2>
  <div class="gal">
    {gallery.map(g => (
      <figure><a href={g.src} target="_blank" rel="noopener"><img src={g.src} alt={g.alt} width={g.w} height={g.h} loading="lazy" /></a><figcaption>{g.cap}</figcaption></figure>
    ))}
  </div>
</section>

<section class="beats ms-beats">
  <div><h3>One platform, two assays</h3><p>NAAT for Zika, dengue and malaria. A fluorescence module for HE4, LYVE-1, PSA, KIM-1 and NGAL. Both share the power board and one printed housing.</p></div>
  <div><h3>Toward the clinic</h3><p>Mapped the regulatory path: a Class II in vitro diagnostic on the 510(k) pathway, under 21 CFR 820 design controls, ISO 13485 and ISO 14971.</p></div>
</section>
</div>

</Base>
<script>
  import '../../scripts/mediscan-explode.js';
  import '../../scripts/mediscan-sense.js';
</script>

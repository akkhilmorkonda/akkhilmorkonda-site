---
import Base from '../../layouts/Base.astro';
import ShowcaseHero from '../../components/ShowcaseHero.astro';
import ShowcaseProject from '../../components/ShowcaseProject.astro';
import { entry, core } from '../../data/site.js';
import '../../styles/case.css';
const e = entry('experience', 'avanos');
---
<Base title={e.page.title} crumb={e.page.crumb} description={e.page.description}>
<div class="wrap"><a class="back" href="/#experience">Back to all experience</a></div>

<div class="wrap"><ShowcaseHero e={e} /></div>

<ShowcaseProject c={core(e, 'fixture')}>
  <div slot="demo" class="wrap demo bat" id="pump">
    <div class="bbox">
      <div class="bbar"><span class="pump-h">10 pumps, 75 psi, 12 hours. Click a pump to make it leak.</span><div class="verdict wait" id="pumpVd" role="status" aria-live="polite"><b>0 h</b></div></div>
      <div class="pgrid" id="pumpGrid" aria-label="Pumps on the fixture"></div>
      <div class="bc pump-c"><canvas id="pumpC" role="img" aria-label="Pressure of 10 pumps held at 75 psi over a 12 hour test; a leaking pump falls past the leak threshold and its power is cut"></canvas></div>
    </div>
    <p class="note">12-hour run compressed to seconds. Illustrative traces, not Avanos data.</p>
  </div>
</ShowcaseProject>

<ShowcaseProject c={core(e, 'analytics')}>
  <div slot="demo" class="wrap demo">
    <figure class="sys" aria-label="System diagram: complaints land in Salesforce and repair records in SAP; the analytics platform pulls both through REST APIs, analyzes them in Python and serves a Streamlit app to R&D and Quality engineers">
      <div class="sys-lane">
        <h4 class="sys-l">Where the data comes from</h4>
        <div class="sys-life">
          <div class="sn">Customer</div><div class="sa"><span>complaint</span></div><div class="sn src">Salesforce<small>complaint record</small></div>
          <div class="sa sv"><span>device shipped</span></div><div></div><div></div>
          <div class="sn">Service center</div><div class="sa"><span>root cause</span></div><div class="sn src">SAP<small>repair record</small></div>
        </div>
      </div>
      <div class="sys-lane mine">
        <h4 class="sys-l">What I built</h4>
        <div class="sys-pipe">
          <div class="sn src2">Salesforce<br />SAP</div>
          <div class="sa"><span>REST APIs</span></div>
          <div class="sn">Python analysis<small>pandas, SciPy, Matplotlib</small></div>
          <div class="sa"><span></span></div>
          <div class="sn">Streamlit app<small>deployed through CI/CD</small></div>
          <div class="sa"><span></span></div>
          <div class="sn">R&amp;D and Quality engineers<small>no SAP training needed</small></div>
        </div>
      </div>
      <div class="sys-rec">
        <h4 class="sys-l">Example record the analysis flags</h4>
        <dl>
          <div><dt>Salesforce complaint</dt><dd>Pump leaking</dd></div>
          <div><dt>SAP root cause</dt><dd>Non-pump fault</dd></div>
          <div><dt>SAP action</dt><dd>Pump replaced, looked old or rusted</dd></div>
          <div class="flag"><dt>Flag</dt><dd>Mislogged pump failure</dd></div>
        </dl>
      </div>
    </figure>
    <p class="note">Simplified system diagram. Example record is illustrative.</p>
  </div>
</ShowcaseProject>

<ShowcaseProject c={core(e, 'robot')}>
  <div slot="demo" class="wrap demo">
    <div class="prod2">
      <figure><div class="pt"><img src="/images/dobot-robot.webp" alt="DOBOT CR5A 6-axis collaborative robot arm" width="720" height="720" loading="lazy" /></div><figcaption>DOBOT CR5A 6-axis robot</figcaption></figure>
      <figure><div class="pt"><img src="/images/cortrak-2.webp" alt="Avanos CORTRAK 2 enteral access system with its receiver and feeding tube stylet" width="300" height="300" loading="lazy" /></div><figcaption>Avanos CORTRAK 2, the system under validation</figcaption></figure>
    </div>
  </div>
</ShowcaseProject>

{e.page.more?.length && (
<div class="wrap">
<section class="xtra" id="more">
  <h2>Additional projects</h2>
  <div class="xrows">
    {e.page.more.map(m => (
      <div class="xrow"><h3>{m.title}</h3><div><p>{m.summary}</p>{m.stack && <ul class="stack" aria-label="Tech stack">{m.stack.map(t => <li>{t}</li>)}</ul>}</div></div>
    ))}
  </div>
</section></div>
)}

</Base>
<script>
  import '../../scripts/pump-trace.js';
</script>

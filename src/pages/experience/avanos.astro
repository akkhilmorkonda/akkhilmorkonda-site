---
import Base from '../../layouts/Base.astro';
import ShowcaseHero from '../../components/ShowcaseHero.astro';
import ShowcaseProject from '../../components/ShowcaseProject.astro';
import { entry, core } from '../../data/site.js';
import '../../styles/case.css';
const e = entry('experience', 'avanos');
---
<Base title={e.page.title} crumb={e.page.crumb} description={e.page.description}>
<div class="wrap"><a class="back" href="/#experience">Back to all experience</a></div>

<div class="wrap"><ShowcaseHero e={e} /></div>

<ShowcaseProject c={core(e, 'fixture')}>
  <div slot="demo" class="wrap demo bat" id="pump">
    <div class="bbox">
      <div class="bbar"><span class="pump-h">10 pumps, 75 psi, 12 hours. Click a pump to make it leak.</span><div class="verdict wait" id="pumpVd" role="status" aria-live="polite"><b>0 h</b></div></div>
      <div class="pgrid" id="pumpGrid" aria-label="Pumps on the fixture"></div>
      <div class="bc pump-c"><canvas id="pumpC" role="img" aria-label="Pressure of 10 pumps held at 75 psi over a 12 hour test; a leaking pump falls past the leak threshold and its power is cut"></canvas></div>
    </div>
    <p class="note">12-hour run compressed to seconds. Illustrative traces, not Avanos data.</p>
  </div>
</ShowcaseProject>

<ShowcaseProject c={core(e, 'analytics')} />

<ShowcaseProject c={core(e, 'robot')}>
  <div slot="demo" class="wrap demo">
    <div class="viewer"><div class="cv"><canvas id="robot" role="img" aria-label="6-axis robot arm following an interpolated path"></canvas></div>
      <div class="ctl">
        <div><label>Trajectory</label><input type="range" id="rT" min="0" max="1000" value="0" aria-label="Trajectory position"></div>
        <button class="btn2" id="rPlay">Pause</button>
        <div id="rJ" class="jt"><div><span>J1 base</span><b>0°</b></div><div><span>J2 shoulder</span><b>0°</b></div><div><span>J3 elbow</span><b>0°</b></div><div><span>J4 wrist roll</span><b>0°</b></div><div><span>J5 wrist pitch</span><b>0°</b></div><div><span>J6 flange</span><b>0°</b></div></div>
        <p class="note">Drag the view to rotate. Illustrative robot and path.</p>
      </div></div>
  </div>
</ShowcaseProject>

{e.page.more?.length && (
<div class="wrap">
<section class="xtra" id="more">
  <h2>Additional projects</h2>
  <div class="xrows">
    {e.page.more.map(m => (
      <div class="xrow"><h3>{m.title}</h3><div><p>{m.summary}</p>{m.stack && <ul class="stack" aria-label="Tech stack">{m.stack.map(t => <li>{t}</li>)}</ul>}</div></div>
    ))}
  </div>
</section></div>
)}

</Base>
<script>
  import '../../scripts/pump-trace.js';
  import '../../scripts/robot.js';
</script>

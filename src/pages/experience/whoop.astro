---
import Base from '../../layouts/Base.astro';
import ShowcaseHero from '../../components/ShowcaseHero.astro';
import ShowcaseProject from '../../components/ShowcaseProject.astro';
import { entry, core } from '../../data/site.js';
import '../../styles/case.css';
const e = entry('experience', 'whoop');
---
<Base title={e.page.title} crumb={e.page.crumb} description={e.page.description}>
<div class="wrap"><a class="back" href="/#experience">Back to all experience</a></div>

<div class="wrap"><ShowcaseHero e={e} /></div>

<ShowcaseProject c={core(e, 'optical')}>
  <Fragment slot="demo">
<section class="explode" id="explode"><div class="stick"><canvas id="rig" role="img" aria-label="Exploded 3D model of the optical testbed; each step below highlights one part"></canvas>
  <div class="steps"><h2>Inside the testbed</h2>
    <div class="st"><b>Blackout enclosure</b><p>Blocks ambient light so only the LED under test reaches the probe.</p></div>
    <div class="st"><b>Breadboard and motor controllers</b><p>Everything bolts to an optical breadboard. Three motor controllers drive the stage, one per axis.</p></div>
    <div class="st"><b>Thorlabs 3-axis stage</b><p>Motorized X, Y and Z translation stages move the probe through space above the device.</p></div>
    <div class="st"><b>Precision fixture</b><p>A dowel-pinned aluminum bracket on the Z stage carries the fiber probe head. A pocket in the base plate locates the device.</p></div>
    <div class="st"><b>Fiber and analysers</b><p>Fiber carries the collected light to Feasa LED and IR analysers that read intensity and color.</p></div>
    <div class="st"><b>WHOOP 5.0</b><p>Sensor side up in its pocket. The LEDs switch on and the probe maps the light above them.</p></div>
  </div><div class="prog" id="prog"></div></div></section>

  </Fragment>
</ShowcaseProject>

<ShowcaseProject c={core(e, 'capacitor')}>
  <div slot="demo" class="wrap demo bat" id="bat">
  <div class="bbox">
    <div class="bbar"><div class="seg3" id="dut"><button class="on" data-h="1">Healthy unit</button><button data-h=".1">Bad capacitor</button></div><div class="verdict" id="vd" role="status" aria-live="polite"><span class="ico">&#10003;</span><b>PASS</b></div></div>
    <div class="bc"><canvas id="cF" role="img" aria-label="Battery current spectrum; a bad capacitor adds a ripple peak that trips the FLAG verdict"></canvas><div class="tip2" id="tF"></div></div>
  </div>
  <p class="note">Current spectrum of one unit. Illustrative model, not WHOOP data.</p>
  </div>
</ShowcaseProject>

<ShowcaseProject c={core(e, 'ate')}>
  <div slot="demo" class="wrap demo fleet" id="fleet">
  <div class="fbox">
    <div class="fbar"><div class="seg3 fseg"><button class="on" data-m="legacy">Legacy ATE</button><button data-m="dag">DAG scheduler</button></div><div class="fres"><span>Fleet run time</span><b class="ftime">100%</b></div></div>
    <div class="fchart"><div class="lanes"></div><div class="over"><div class="endline"></div></div></div>
    <div class="flegend"><span><b>F</b> Flash</span><span><b>B</b> Boot</span><span><b>S</b> Sensors</span><span><b>P</b> Battery</span><span><b>O</b> Optical</span><span><b>R</b> Radio</span></div>
  </div>
  <p class="note">Illustrative step names and timings.</p>
  </div>
</ShowcaseProject>

<div class="wrap">
<section class="xtra" id="more">
  <h2>Additional projects</h2>
  <div class="xrows">
    {e.page.more.map(m => (
      <div class="xrow"><h3>{m.title}</h3><div><p>{m.summary}</p>{m.stack && <ul class="stack" aria-label="Tech stack">{m.stack.map(t => <li>{t}</li>)}</ul>}</div><span class="xres">{m.result}</span></div>
    ))}
  </div>
</section></div>

</Base>
<script>
  import '../../scripts/testbed.js';
  import '../../scripts/battery.js';
  import '../../scripts/fleet.js';
</script>

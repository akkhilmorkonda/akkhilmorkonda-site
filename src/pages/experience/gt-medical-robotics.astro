---
import Base from '../../layouts/Base.astro';
import ShowcaseProject from '../../components/ShowcaseProject.astro';
import { entry, core } from '../../data/site.js';
import '../../styles/case.css';
const e = entry('experience', 'gt-medical-robotics');
---
<Base title={e.page.title} crumb={e.page.crumb} description={e.page.description}>
<div class="wrap"><a class="back" href="/#experience">Back to all experience</a></div>

<ShowcaseProject c={core(e, 'hand')} role={e.page.roleLine}>
  <div slot="demo" class="wrap demo">
    <div class="viewer hand-v"><div class="cv"><canvas id="handCv" tabindex="0" role="img" aria-label="Exploded 3D view of the team's prosthetic hand CAD: palm and wrist mount, back plate, thumb and four fingers. Drag or use the arrow keys to rotate."></canvas><p class="loading note">Loading the CAD model</p></div>
      <div class="ctl">
        <div><label for="hEx">Explode</label><input type="range" id="hEx" min="0" max="100" value="35" /></div>
        <p class="note">Team CAD, simplified for the web. Drag to rotate.</p>
      </div></div>
  </div>
</ShowcaseProject>

</Base>
<script>import '../../scripts/gt-hand.js';</script>

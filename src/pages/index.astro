---
import Base from '../layouts/Base.astro';
import { site, hero, about, education, experience, projects, research } from '../data/site.js';
---
<Base>
<div class="wrap">
  <section class="h-hero">
    <div class="h-copy">
      <div class="h-draw"><h1>{hero.headline.split(' ').map(w => <><span class="w">{w}</span>{' '}</>)}</h1><svg aria-hidden="true"></svg></div>
      <p class="h-sub">{hero.sub}</p>
      <div class="h-ctas"><a class="cta" href="#experience">See my work</a><a class="cta gh" href={`mailto:${site.email}`}>Email me</a></div>
    </div>
    <figure class="h-vis">
      <div class="h-sig"><span id="heroSigName">EMG burst</span><a id="heroSigLink" href="/research/wearable-robotics">Wearable Robotics Lab</a></div>
      <canvas id="heroSig" role="img" aria-label="A measured signal from one of Akkhil's projects, cycling through EMG, battery current spectrum, LAMP amplification, tone stack response and plantar load"></canvas>
      <div class="h-chips" id="heroChips"><button type="button">EMG lab</button><button type="button">WHOOP</button><button type="button">MediScan</button><button type="button">Amp head</button><button type="button">Insole</button></div>
      <figcaption>One signal from each build. Illustrative traces.</figcaption>
    </figure>
  </section>

  <section id="about" class={`s-about${site.portrait ? ' has-p' : ''}`}>
    <p class="statement">{about}</p>
    {site.portrait && <img class="portrait" src={site.portrait} alt={`Portrait of ${site.name}`} width="560" height="700" loading="lazy" />}
  </section>

  <section id="education" class="s-edu">
    <h2>Georgia Tech</h2>
    <div class="tiles">
      <div class="t acc"><span>GPA</span><b>{education.gpa}</b></div>
      <div class="t"><span>Graduating</span><b>May 2027</b></div>
      <div class="t wide"><span>{education.dates}</span><b>{education.degree}</b><em>{education.minor}</em></div>
    </div>
    <p class="ta"><b>Undergraduate Teaching Assistant, {education.ta.course}.</b> {education.ta.text}</p>
  </section>

  <section id="experience" class="s-exp">
    <h2>Experience</h2>
    <div class="rows">
      {experience.map(e => (
        <a class="row" href={`/experience/${e.slug}`}>
          <div class="who"><h3>{e.company}</h3><span>{e.role}</span><span class="d">{e.dates}</span></div>
          <p>{e.summary}</p>
          <div class="st"><b>{e.stat}</b><span>{e.statLabel}</span><span class="go" aria-hidden="true">Read case study</span></div>
        </a>
      ))}
    </div>
  </section>

  <section id="projects" class="s-proj">
    <h2>Things I've built</h2>
    <div class="bento">
      {projects.map((p, i) => (
        <article class={`cell${p.feature ? ' feat' : ''}${p.wide ? ' wide' : ''}${p.slug ? ' has-page' : ''}`}>
          <span class="tag">{p.tag}</span>
          <h3>{p.link ? <a href={p.link}>{p.name}</a> : p.slug ? <a href={`/projects/${p.slug}`}>{p.name}</a> : p.name}</h3>
          <p>{p.text}</p>
          {p.slug && <span class="more-l" aria-hidden="true">See the project</span>}
          {p.link && <span class="more-l" aria-hidden="true">{new URL(p.link).host}</span>}
        </article>
      ))}
    </div>
  </section>

  <section id="research" class="s-res">
    <h2>Research</h2>
    <div class="labs">
      {research.map(r => (
        <div class="lab"><h3>{r.slug ? <a href={`/research/${r.slug}`}>{r.lab}</a> : r.lab}</h3><span>{r.role}, {r.dates}</span><p>{r.text}</p>{r.slug && <span class="more-l" aria-hidden="true">See the research</span>}</div>
      ))}
    </div>
  </section>

  <section id="contact" class="s-contact">
    <h2>Open to 2027 roles.</h2>
    <p>Hardware, medtech and research.</p>
    <div class="h-ctas"><a class="cta" href={`mailto:${site.email}`}>Email me</a><a class="cta gh" href={site.linkedin}>LinkedIn</a></div>
  </section>
</div>
</Base>
<script>import '../scripts/hero-callouts.js'; import '../scripts/hero-signal.js';</script>
<style>
  section{padding:110px 0 0}
  h2{font-size:clamp(28px,3.4vw,46px);margin-bottom:36px}
  .h-hero{display:grid;grid-template-columns:1.25fr .75fr;gap:48px;align-items:center;min-height:calc(100dvh - 64px);padding:48px 0}
  .h-hero h1{font-size:clamp(34px,4.3vw,58px);line-height:1.04}
  .h-sub{margin-top:22px;font-size:clamp(17px,1.4vw,20px);line-height:1.5;color:var(--fg2);max-width:46ch}
  .h-ctas{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}
  .h-draw{position:relative;padding:30px 0 34px}
  .h-draw svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}
  .h-draw :global(path.ln),.h-draw :global(rect.ln){stroke:var(--mu);stroke-width:1;fill:none}
  .h-draw :global(path.lnA){stroke:var(--ac);stroke-width:1;fill:none}
  .h-draw :global(text){font:11px var(--fm);fill:var(--mu)}
  .h-draw :global(text.a){fill:var(--ac)}
  .h-sig{display:flex;justify-content:space-between;gap:12px;margin-bottom:10px;font:12px var(--fm);color:var(--mu)}
  .h-sig a{color:var(--ac)}.h-sig a:hover{text-decoration:underline;text-underline-offset:3px}
  .h-vis canvas{display:block;width:100%;height:260px}
  .h-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
  .h-chips button{min-height:44px;padding:0 12px;background:none;border:1px solid var(--ln);color:var(--mu);font:500 12px var(--fm);cursor:pointer}
  .h-chips button:hover{color:var(--fg)}
  .h-chips button.on{border-color:var(--ac);color:var(--ac)}
  .h-vis figcaption{margin-top:10px;font:12px var(--fm);color:var(--mu)}
  @media (max-width:560px){.h-vis canvas{height:200px}}
  @media (max-width:380px){.h-hero h1{font-size:29px}}
  .s-about{border-top:1px solid var(--ln)}
  .s-about.has-p{display:grid;grid-template-columns:1.4fr .7fr;gap:56px;align-items:center}
  .statement{font:500 clamp(22px,2.3vw,32px)/1.35 var(--fb);letter-spacing:-.01em;max-width:40ch}
  .portrait{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover}
  .tiles{display:grid;grid-template-columns:1fr 1fr 2fr;gap:1px;background:var(--ln);border:1px solid var(--ln)}
  .t{background:var(--bg);padding:26px;min-height:170px;display:flex;flex-direction:column;justify-content:space-between}
  .t span{font-size:13px;color:var(--mu)}
  .t b{font:700 clamp(26px,2.8vw,40px)/1 var(--fd)}
  .t.acc{background:var(--ac)}.t.acc span,.t.acc b{color:var(--on)}
  .t.wide b{font-size:clamp(20px,2vw,28px);line-height:1.15}
  .t em{font-style:normal;color:var(--mu);font-size:15px;margin-top:6px}
  .ta{margin-top:20px;font-size:15px;line-height:1.55;color:var(--fg2);max-width:80ch}
  .ta b{color:var(--fg);font-weight:600}
  .rows{border-top:1px solid var(--ln)}
  .row{display:grid;grid-template-columns:1fr 1.4fr .8fr;gap:32px;align-items:start;padding:32px 0;border-bottom:1px solid var(--ln);position:relative;transition:background .25s}
  .row:hover{background:var(--sf)}
  .row h3{font:700 22px/1.1 var(--fd);text-transform:uppercase}
  .who span{display:block;margin-top:6px;font-size:14px;color:var(--mu)}
  .who .d{font:12px var(--fm)}
  .row p{font-size:16px;line-height:1.55;color:var(--fg2)}
  .row .st b{display:block;font:700 34px/1 var(--fd);color:var(--ac)}
  .row .st span{display:block;margin-top:8px;font-size:13px;color:var(--mu)}
  .row .st .go{margin-top:18px;font:12px var(--fm);color:var(--mu);transition:color .2s}
  .row:hover .go{color:var(--ac)}
  .bento{display:grid;grid-template-columns:1.4fr 1fr 1fr;grid-auto-flow:dense;gap:1px;background:var(--ln);border:1px solid var(--ln)}
  .cell{position:relative;background:var(--bg);padding:28px;min-height:220px;display:flex;flex-direction:column}
  .cell .tag{font:12px var(--fm);color:var(--mu)}
  .cell h3{font:700 20px/1.15 var(--fd);text-transform:uppercase;margin-top:auto;padding-top:40px}
  .cell p{margin-top:10px;font-size:15px;line-height:1.5;color:var(--fg2)}
  .cell.feat{grid-row:1/3;background:var(--sf)}
  .cell.feat h3{font-size:clamp(24px,2.4vw,34px)}
  .cell.wide{grid-column:1/-1;min-height:0}
  .cell.wide h3{font-size:clamp(22px,2.2vw,30px);padding-top:28px}
  .cell.wide p{max-width:70ch}
  /* the title link covers the whole cell, so the full cell is the click target */
  .cell h3 a::after{content:"";position:absolute;inset:0}
  .cell:has(h3 a){transition:background .25s}.cell:has(h3 a):hover{background:var(--sf)}
  .cell.feat:has(h3 a):hover{background:#1d1d20}
  .more-l{margin-top:14px;font:12px var(--fm);color:var(--ac)}.cell:hover .more-l{text-decoration:underline;text-underline-offset:3px}
  .cell h3 a:hover{color:var(--ac)}
  .labs{display:grid;grid-template-columns:1fr 1fr;gap:56px;border-top:1px solid var(--ln);padding-top:28px}
  .lab{position:relative}
  .lab h3{font:600 20px/1.3 var(--fb)}
  .lab h3 a::after{content:"";position:absolute;inset:-16px}
  .lab h3 a:hover,.lab:hover h3 a{color:var(--ac)}
  .lab:hover .more-l{text-decoration:underline;text-underline-offset:3px}
  .lab .more-l{display:inline-block;margin-top:14px;color:var(--ac)}
  .lab span{display:block;margin-top:6px;font:12px var(--fm);color:var(--mu)}
  .lab p{margin-top:14px;font-size:16px;line-height:1.55;color:var(--fg2)}
  .s-contact{padding:140px 0 120px}
  .s-contact h2{font-size:clamp(40px,6vw,88px);margin-bottom:16px}
  .s-contact p{font-size:18px;color:var(--fg2)}
  @media (max-width:900px){
    .h-hero,.s-about.has-p,.labs{grid-template-columns:1fr}
    .h-hero{min-height:auto}
    .tiles{grid-template-columns:1fr 1fr}.t.wide{grid-column:1/3}
    .row{grid-template-columns:1fr;gap:12px;padding-bottom:44px}
    .bento{grid-template-columns:1fr}.cell.feat{grid-row:auto}.cell.wide{grid-column:auto}
    .cell p,.ta{font-size:16px}
  }
</style>

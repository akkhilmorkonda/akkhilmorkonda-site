---
import Base from '../layouts/Base.astro';
import { site, hero, about, education, experience, projects, research } from '../data/site.js';
---
<Base>
<div class="wrap">
  <section class="h-hero">
    <div class="h-copy">
      <h1>{hero.headline}</h1>
      <p class="h-sub">{hero.sub}</p>
      <div class="h-ctas"><a class="cta" href="#experience">See my work</a><a class="cta gh" href={`mailto:${site.email}`}>Email me</a></div>
    </div>
    <div class="h-vis"><canvas id="heroPod" aria-label="Rotating wireframe of a wearable sensor pod"></canvas></div>
  </section>

  <section id="about" class="s-about">
    <p class="statement">{about}</p>
    <figure class="portrait"><div class="slot" role="img" aria-label="Portrait placeholder"></div><figcaption>Portrait coming soon.</figcaption></figure>
  </section>

  <section id="education" class="s-edu">
    <h2>Georgia Tech</h2>
    <div class="tiles">
      <div class="t acc"><span>GPA</span><b>{education.gpa}</b></div>
      <div class="t"><span>Graduating</span><b>May 2027</b></div>
      <div class="t wide"><span>{education.dates}</span><b>{education.degree}</b><em>{education.minor}</em></div>
    </div>
    <p class="ta"><b>Undergraduate Teaching Assistant, {education.ta.course}.</b> {education.ta.text}</p>
  </section>

  <section id="experience" class="s-exp">
    <h2>Experience</h2>
    <div class="rows">
      {experience.map(e => (
        <a class="row" href={`/experience/${e.slug}`}>
          <div class="who"><h3>{e.company}</h3><span>{e.role}</span><span class="d">{e.dates}</span></div>
          <p>{e.summary}</p>
          <div class="st"><b>{e.stat}</b><span>{e.statLabel}</span></div>
          <span class="go" aria-hidden="true">Read case study</span>
        </a>
      ))}
    </div>
  </section>

  <section id="projects" class="s-proj">
    <h2>Things I've built</h2>
    <div class="bento">
      {projects.map((p, i) => (
        <article class={`cell c${i}${p.feature ? ' feat' : ''}`}>
          <span class="tag">{p.tag}</span>
          <h3>{p.link ? <a href={p.link}>{p.name}</a> : p.slug ? <a href={`/projects/${p.slug}`}>{p.name}</a> : p.name}</h3>
          <p>{p.text}</p>
          {p.slug && <a class="more-l" href={`/projects/${p.slug}`}>See the project</a>}
        </article>
      ))}
    </div>
  </section>

  <section id="research" class="s-res">
    <h2>Research</h2>
    <div class="labs">
      {research.map(r => (
        <div class="lab"><h3>{r.lab}</h3><span>{r.role}, {r.dates}</span><p>{r.text}</p></div>
      ))}
    </div>
    <figure class="emg" id="emg">
      <div class="emg-h"><span>Raw EMG, envelope, control signal</span><button class="emg-b" id="emgFlex" aria-pressed="false">Hold to flex</button></div>
      <canvas id="emgC" aria-label="Scrolling EMG trace: raw signal, rectified envelope, and thresholded control output"></canvas>
      <figcaption>Rectify, low-pass, threshold. Illustrative signal, not study data.</figcaption>
    </figure>
  </section>

  <section id="contact" class="s-contact">
    <h2>Get in touch.</h2>
    <p>Open to 2027 roles in hardware, medtech and research.</p>
    <div class="h-ctas"><a class="cta" href={`mailto:${site.email}`}>Email me</a><a class="cta gh" href={site.linkedin}>LinkedIn</a></div>
  </section>
</div>
</Base>
<script>import '../scripts/hero-pod.js'; import '../scripts/emg.js';</script>
<style>
  section{padding:110px 0 0}
  h2{font-size:clamp(28px,3.4vw,46px);margin-bottom:36px}
  .h-hero{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center;min-height:calc(100dvh - 64px);padding:48px 0}
  .h-hero h1{font-size:clamp(38px,5vw,70px)}
  .h-sub{margin-top:22px;font-size:clamp(17px,1.4vw,20px);line-height:1.5;color:#c9c9c5;max-width:46ch}
  .h-ctas{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}
  .h-vis canvas{display:block;width:100%;height:min(60vh,520px);cursor:grab}
  .s-about{display:grid;grid-template-columns:1.4fr .7fr;gap:56px;align-items:center;border-top:1px solid var(--ln)}
  .statement{font:500 clamp(22px,2.3vw,32px)/1.35 var(--fb);letter-spacing:-.01em;max-width:34ch}
  .portrait .slot{aspect-ratio:4/5;background:radial-gradient(120% 90% at 30% 20%,#123326,var(--sf) 60%);box-shadow:inset 0 0 0 1px var(--ln)}
  .portrait figcaption{margin-top:10px;font:12px var(--fm);color:var(--mu)}
  .tiles{display:grid;grid-template-columns:1fr 1fr 2fr;gap:1px;background:var(--ln);border:1px solid var(--ln)}
  .t{background:var(--bg);padding:26px;min-height:170px;display:flex;flex-direction:column;justify-content:space-between}
  .t span{font-size:13px;color:var(--mu)}
  .t b{font:700 clamp(26px,2.8vw,40px)/1 var(--fd)}
  .t.acc{background:var(--ac)}.t.acc span,.t.acc b{color:var(--on)}
  .t.wide b{font-size:clamp(20px,2vw,28px);line-height:1.15}
  .t em{font-style:normal;color:var(--mu);font-size:15px;margin-top:6px}
  .ta{margin-top:20px;font-size:15px;line-height:1.55;color:#c9c9c5;max-width:80ch}
  .ta b{color:var(--fg);font-weight:600}
  .rows{border-top:1px solid var(--ln)}
  .row{display:grid;grid-template-columns:1fr 1.4fr .8fr;gap:32px;align-items:start;padding:32px 0;border-bottom:1px solid var(--ln);position:relative;transition:background .25s}
  .row:hover{background:linear-gradient(90deg,transparent,#16ec9a0d)}
  .row h3{font:700 22px/1.1 var(--fd);text-transform:uppercase}
  .who span{display:block;margin-top:6px;font-size:14px;color:var(--mu)}
  .who .d{font:12px var(--fm)}
  .row p{font-size:16px;line-height:1.55;color:#c9c9c5}
  .row .st b{display:block;font:700 34px/1 var(--fd);color:var(--ac)}
  .row .st span{display:block;margin-top:8px;font-size:13px;color:var(--mu)}
  .row .go{position:absolute;right:0;bottom:12px;font:12px var(--fm);color:var(--mu);transition:color .2s}
  .row:hover .go{color:var(--ac)}
  .bento{display:grid;grid-template-columns:1.4fr 1fr 1fr;grid-template-rows:auto auto;gap:1px;background:var(--ln);border:1px solid var(--ln)}
  .cell{background:var(--bg);padding:28px;min-height:220px;display:flex;flex-direction:column}
  .cell .tag{font:12px var(--fm);color:var(--mu)}
  .cell h3{font:700 20px/1.15 var(--fd);text-transform:uppercase;margin-top:auto;padding-top:40px}
  .cell p{margin-top:10px;font-size:15px;line-height:1.5;color:#c9c9c5}
  .cell.feat{grid-row:1/3;background:linear-gradient(#0e0e0fcc,#0e0e0f),repeating-linear-gradient(0deg,#16ec9a14 0 1px,transparent 1px 24px),repeating-linear-gradient(90deg,#16ec9a14 0 1px,transparent 1px 24px)}
  .cell.feat h3{font-size:clamp(24px,2.4vw,34px)}
  .cell.c1{background:#101a15}
  .more-l{margin-top:14px;font:12px var(--fm);color:var(--ac)}
  .cell h3 a:hover{color:var(--ac)}
  .labs{display:grid;grid-template-columns:1fr 1fr;gap:56px;border-top:1px solid var(--ln);padding-top:28px}
  .lab h3{font:600 20px/1.3 var(--fb)}
  .lab span{display:block;margin-top:6px;font:12px var(--fm);color:var(--mu)}
  .emg{margin-top:48px;border:1px solid var(--ln)}
  .emg-h{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--ln);font:500 12px var(--fm);color:var(--mu)}
  .emg-b{background:none;border:1px solid var(--ac);color:var(--ac);font:600 12.5px var(--fb);padding:7px 14px;cursor:pointer;user-select:none;touch-action:none;white-space:nowrap}
  .emg-b[aria-pressed=true]{background:var(--ac);color:var(--on)}
  #emgC{display:block;width:100%;height:240px}
  @media (max-width:560px){#emgC{height:280px}}
  .emg figcaption{padding:10px 16px;border-top:1px solid var(--ln);font:12px var(--fm);color:var(--mu)}
  .lab p{margin-top:14px;font-size:16px;line-height:1.55;color:#c9c9c5}
  .s-contact{padding:140px 0 120px}
  .s-contact h2{font-size:clamp(40px,6vw,88px);margin-bottom:16px}
  .s-contact p{font-size:18px;color:#c9c9c5}
  @media (max-width:900px){
    .h-hero,.s-about,.labs{grid-template-columns:1fr}
    .h-hero{min-height:auto}
    .tiles{grid-template-columns:1fr 1fr}.t.wide{grid-column:1/3}
    .row{grid-template-columns:1fr;gap:12px;padding-bottom:44px}
    .bento{grid-template-columns:1fr}.cell.feat{grid-row:auto}
  }
</style>

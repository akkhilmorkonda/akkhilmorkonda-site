---
// The four questions every deep dive answers, right under its hero. Real facts only;
// if a "why" is not confirmed by Akkhil, keep it modest and log it in docs/ as [?].
interface Props { what: string; why: string; how: string[]; results: string[]; }
const { what, why, how, results } = Astro.props;
---
<section class="brief" aria-label="Summary">
  <div><h2>What</h2><p>{what}</p></div>
  <div><h2>Why</h2><p>{why}</p></div>
  <div><h2>How</h2><ul>{how.map(h => <li>{h}</li>)}</ul></div>
  <div class="res"><h2>Results</h2><ul>{results.map(r => <li>{r}</li>)}</ul></div>
</section>

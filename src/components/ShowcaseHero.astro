---
// Top of a showcase page (page.showcase in portfolio.yaml): title, role, intro,
// then one card per core project that jumps to its section.
const { e } = Astro.props;
const p = e.page;
const words = p.headline.split(' ');
---
<section class={`hero sc-hero${p.image ? ' has-img' : ''}`}>
  <div><h1>{words.map((w, i) => <>{w.includes('-') ? <span class="nw">{w}</span> : w}{i < words.length - 1 ? ' ' : ''}</>)}</h1><div class="role">{p.roleLine}</div>
    <p class="lead">{p.lead}</p>
  </div>
  {p.image && <figure class="sc-img"><img src={p.image.src} alt={p.image.alt} width="900" height="900" />{p.image.credit && <figcaption>{p.image.credit}</figcaption>}</figure>}
</section>
<nav class="sc-index" aria-label="Projects on this page">
  {p.core.map(c => (
    <a class="sc-card" href={`#${c.key}`}>
      <span class="sc-t">{c.title}</span>
      <span class="sc-s">{c.summary}</span>
      <span class="go" aria-hidden="true">See the project</span>
    </a>
  ))}
</nav>
